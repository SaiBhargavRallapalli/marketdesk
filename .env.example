# ---------- Telegram alerts (free) ----------
# 1. Message @BotFather on Telegram -> /newbot -> copy token
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Email alerts (free, use Gmail App Password) ----------
# Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# ---------- Broker APIs (optional, pluggable) ----------
# Dhan: https://dhan.co -> Developer Console -> create app
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Angel One SmartAPI: https://smartapi.angelone.in
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
# Base32 TOTP secret from Angel One (optional, for auto-login)
ANGEL_TOTP_SECRET=

# Shoonya (Finvasia): https://shoonya.com -> API section
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=

# Zerodha Kite Connect (PAID product ~Rs 2000/mo, only if you already have it)
KITE_API_KEY=
KITE_ACCESS_TOKEN=
